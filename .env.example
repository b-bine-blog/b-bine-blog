# 001 회원 기능 실행에 필요한 환경변수 (specs/001-member-auth/quickstart.md "준비")
DB_URL=
DB_USERNAME=
DB_PASSWORD=
# 32바이트 이상 무작위 값
JWT_SECRET=
# 인증번호 HMAC 키
CODE_HASH_SECRET=
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
# Gmail 앱 비밀번호
MAIL_PASSWORD=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# 프로필 사진 저장 폴더
FILE_STORAGE_ROOT=./uploads
# 002 블로그: 블랙리스트 HMAC 키(바꾸지 않음)
BLACKLIST_HASH_SECRET=
# 블로그 생성 개수 제한(선택). 공개는 1~5
BLOG_LIMIT_PUBLIC=3
BLOG_LIMIT_PRIVATE=5
# 글 미리보기(og) 주소를 만들 때 쓰는 사이트 주소 (004 research R-12)
APP_BASE_URL=http://localhost:8080
